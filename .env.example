# Copy to .env.local and fill in. Never commit .env.local.

# Reddit (script app) — https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=gap-scout/0.1 by <your-reddit-username>

# Porkbun — https://porkbun.com/account/api (also enable API access per domain)
PORKBUN_API_KEY=
PORKBUN_SECRET_API_KEY=

# Vercel — https://vercel.com/account/tokens
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Supabase personal access token — https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=
SUPABASE_ORG_ID=

# Resend — https://resend.com/api-keys
RESEND_API_KEY=
NOTIFY_EMAIL=

# Stripe TEST MODE ONLY — restricted key (rk_test_...) + publishable key (pk_test_...)
STRIPE_RESTRICTED_KEY=
STRIPE_PUBLISHABLE_KEY=

# GitHub — automation only (fine-grained PAT, 30–90 day expiry). Manual runs use `gh auth login`.
GITHUB_TOKEN=
